@func: int {
  n.0: int = const 5;
  ret n.0;
}
@loop(infinite: bool, print: bool) {
  jmp .entry;
.entry:
  jmp .loop.header;
.loop.header:
  br infinite .loop.body .loop.end;
.loop.body:
  br print .loop.print .loop.next;
.loop.print:
  v.0: int = call @func;
  print v.0;
  jmp .loop.next;
.loop.next:
  jmp .loop.header;
.loop.end:
  ret;
}
@main {
  infinite.0: bool = const false;
  print.0: bool = const true;
  call @loop infinite.0 print.0;
  ret;
}
